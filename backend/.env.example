# Copie este arquivo para ".env" e preencha os valores reais.
# O arquivo ".env" NUNCA vai para o Git.

# Ambiente: development ou production
APP_ENV=development

# Em produção deve ser false (não exibir detalhes de erro)
APP_DEBUG=true

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4